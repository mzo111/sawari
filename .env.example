# Copy to .env and fill in. Never commit .env — it's gitignored.

# AISStream.io API key. AISStream allows only one live websocket connection
# per key, so don't run a probe script and the ingest worker at the same time.
AISSTREAM_API_KEY=

POSTGRES_PASSWORD=sawari

# Optional. JSON list of [[lat_min, lon_min], [lat_max, lon_max]] boxes,
# same format as AISStream's BoundingBoxes. Unset = the southern North Sea /
# Channel box hardcoded in ingest/worker.py (recorded in DESIGN.md).
AIS_BOUNDING_BOXES=
